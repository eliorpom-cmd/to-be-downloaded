<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The extension only passes a link to the app: it needs no access to disk,
	     network, or anything else. Like the host app, it is not sandboxed — a
	     sandboxed extension in an unsandboxed app won't load. -->
</dict>
</plist>
