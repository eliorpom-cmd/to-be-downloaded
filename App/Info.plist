<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!-- Le menu de l'app, à côté de la pomme : « To be downloaded », « Quit To
	     be downloaded ». Distinct du nom de fichier ($(PRODUCT_NAME) = TBD). -->
	<key>CFBundleName</key>
	<string>$(INFOPLIST_KEY_CFBundleName)</string>
	<!-- Finder et Spotlight : le sigle seul ne dirait rien à qui cherche. -->
	<key>CFBundleDisplayName</key>
	<string>$(INFOPLIST_KEY_CFBundleDisplayName)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- L'icône vit dans Assets.car (compilée depuis App/Resources/AppIcon.icon)
	     et non plus en .icns à côté : c'est CFBundleIconName qui la désigne. -->
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string>Outil personnel</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<!-- Cible des liens envoyés par l'extension de partage. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>tbd</string>
			</array>
		</dict>
	</array>
	<!-- Entrée du menu Services : marche depuis n'importe quelle app dès qu'un
	     lien YouTube est sélectionné. -->
	<key>NSServices</key>
	<array>
		<dict>
			<!-- Le sigle et non le nom complet : l'entrée s'insère dans un
			     menu déjà chargé, « Download with To be downloaded » s'y
			     lirait mal. -->
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Download with $(PRODUCT_NAME)</string>
			</dict>
			<key>NSMessage</key>
			<string>downloadYouTubeLink</string>
			<!-- Doit désigner l'exécutable, donc PRODUCT_NAME. -->
			<key>NSPortName</key>
			<string>$(PRODUCT_NAME)</string>
			<key>NSSendTypes</key>
			<array>
				<string>public.url</string>
				<string>public.utf8-plain-text</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
