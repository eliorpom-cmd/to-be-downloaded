<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!-- The app menu, next to the Apple logo: "To be downloaded", "Quit To
	     be downloaded". Distinct from the file name ($(PRODUCT_NAME) = TBD). -->
	<key>CFBundleName</key>
	<string>$(INFOPLIST_KEY_CFBundleName)</string>
	<!-- Finder and Spotlight: the acronym alone would mean nothing to anyone searching. -->
	<key>CFBundleDisplayName</key>
	<string>$(INFOPLIST_KEY_CFBundleDisplayName)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- The icon lives in Assets.car (compiled from App/Resources/AppIcon.icon)
	     and no longer as a .icns file next to it: CFBundleIconName designates it. -->
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string>Outil personnel</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<!-- Target for links sent by the share extension. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>tbd</string>
			</array>
		</dict>
	</array>
	<!-- Services menu entry: works in any app as long as a
	     YouTube link is selected. -->
	<key>NSServices</key>
	<array>
		<dict>
			<!-- The acronym, not the full name: the entry is inserted into an
			     already-loaded menu, "Download with To be downloaded" would read
			     poorly there. -->
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Download with $(PRODUCT_NAME)</string>
			</dict>
			<key>NSMessage</key>
			<string>downloadYouTubeLink</string>
			<!-- Must designate the executable, hence PRODUCT_NAME. -->
			<key>NSPortName</key>
			<string>$(PRODUCT_NAME)</string>
			<key>NSSendTypes</key>
			<array>
				<string>public.url</string>
				<string>public.utf8-plain-text</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
