<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Outside App Store: app NOT sandboxed (no com.apple.security.app-sandbox). -->
	<!-- Required to launch subprocesses (yt-dlp/ffmpeg) and a LAN HTTP server. -->

	<!-- Required when signing yt-dlp (PyInstaller bootloader) with hardened runtime. -->
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<!-- Allows loading of binaries/dylibs signed differently (bundled ffmpeg). -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
